sha256sums=('f1d71951f57146b8a1e4de3d1e888d92ee430010c4d57ea70ad5b32aa5bb2ed2')

package() {
  tar -xzf "$srcdir/wallust-${pkgver}-x86_64.tar.gz" -C "$pkgdir"
}
