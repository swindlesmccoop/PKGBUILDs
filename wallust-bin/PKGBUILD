# Maintainer: swindlesmccoop@waifu.club
pkgname=wallust-bin
_pkgname=wallust
pkgver=4.1.0.alpha
_pkgver="${pkgver%.alpha}-alpha"
pkgrel=1
pkgdesc="Generate colors from an image (prebuilt binary)"
arch=('x86_64')
url="https://codeberg.org/explosion-mental/wallust"
license=('MIT')
options=(!strip)
optdepends=('imagemagick: wal backend')
conflicts=('wallust')
provides=('wallust')
source=("${_pkgname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/${_pkgver}/${_pkgname}-${_pkgver}-x86_64-unknown-linux-musl.tar.gz"
        "LICENSE-${pkgver}::${url}/raw/tag/${_pkgver}/LICENSE")
sha256sums=('edddf22ba98c4374728a81ce7dfac45c0c6ffcc2528117b4a5198b10778ce8a3'
            '3a62887f73cd035ac1068bc0127ce94291f7a03843391f56df3520e2ca2037f8')

package() {
  cd "$srcdir/${_pkgname}-${_pkgver}-x86_64-unknown-linux-musl"

  install -D -m0755 wallust "$pkgdir/usr/bin/wallust"

  local _man
  for _man in man/*.[15]; do
    install -D -m0644 "$_man" "$pkgdir/usr/share/man/man${_man##*.}/${_man##*/}"
  done

  install -D -m0644 completions/wallust.fish \
      "$pkgdir/usr/share/fish/vendor_completions.d/wallust.fish"
  install -D -m0644 completions/wallust.bash \
      "$pkgdir/usr/share/bash-completion/completions/wallust"
  install -D -m0644 completions/_wallust \
      "$pkgdir/usr/share/zsh/site-functions/_wallust"

  install -D -m0644 "$srcdir/LICENSE-${pkgver}" \
      "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
