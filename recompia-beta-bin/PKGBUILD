# Maintainer: swindlesmccoop@waifu.club
pkgname=recompia-beta-bin
_pkgname=PokopiaRecomp
pkgver=0.9.1.beta.2
_pkgver=${pkgver/.beta./-beta.}
pkgrel=1
pkgdesc="Launcher and PC port of Pokopia, built through Proton (prebuilt binary, testing builds)"
arch=('x86_64')
url="https://github.com/Dittobyte/Recompia"
license=('GPL-3.0-only')
options=(!strip)
depends=('fuse2' 'hicolor-icon-theme')
optdepends=('steam: provides Proton Experimental, needed to build and run the game'
            'umu-launcher: alternative to Steam for running the game'
            'wine: alternative to Steam for running the game')
conflicts=('recompia' 'recompia-bin')
provides=('recompia')
source=("${_pkgname}-${_pkgver}-linux-x64.tar.gz::${url}/releases/download/v${_pkgver}/${_pkgname}-${_pkgver}-linux-x64.tar.gz"
        "recompia-${pkgver}.png::https://raw.githubusercontent.com/Dittobyte/Recompia/v${_pkgver}/launcher/src-tauri/icons-testing/icon.png")
sha256sums=('064a965d5d7fa1cf85adbd97659f861fa30cd30c3d0bd18a6056587bce011305'
            '9b6c3134fc33020b5ccfe3777dcc58c8e8fd8e2f617bc3ff61178ff914949a98')

package() {
  cd "$srcdir/${_pkgname}-${_pkgver}"

  install -d "$pkgdir/usr/share/recompia"
  cp -r --no-preserve=ownership . "$pkgdir/usr/share/recompia/"
  chmod 0755 "$pkgdir/usr/share/recompia/PokopiaLauncher.AppImage"
  echo "$pkgver" > "$pkgdir/usr/share/recompia/.pkgver"

  # The launcher writes saves, settings and the built pkp.exe next to itself and
  # updates itself in place, so run it from a writable per-user copy.
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/recompia" <<'EOF'
#!/bin/sh
src=/usr/share/recompia
dest="${XDG_DATA_HOME:-$HOME/.local/share}/recompia"
stamp="$(cat "$src/.pkgver")"

if [ ! -f "$dest/.pkgver" ] || [ "$(cat "$dest/.pkgver")" != "$stamp" ]; then
  mkdir -p "$dest"
  cp -r --remove-destination "$src/." "$dest/"
  chmod -R u+w "$dest"
fi

cd "$dest" || exit 1
exec ./PokopiaLauncher.AppImage "$@"
EOF
  chmod 0755 "$pkgdir/usr/bin/recompia"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/recompia.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Pokopia Recomp
Comment=Launcher for the Pokopia PC recompilation
Exec=recompia
Icon=recompia
Categories=Game;
Terminal=false
EOF
  install -D -m0644 "$srcdir/recompia-${pkgver}.png" \
      "$pkgdir/usr/share/icons/hicolor/256x256/apps/recompia.png"
  install -D -m0644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
